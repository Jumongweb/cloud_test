groups:
  - name: example-alerts
    rules:
      - alert: HighMemoryUsage
        expr: container_memory_usage_bytes{container_name="app"} > 100000000
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "High memory usage detected"
          description: "Memory usage has been above 100MB for 5 minutes."
